{"format":"rumham-quiz","version":3,"title":"Quiz Night","created":"2026-10-11","rounds":[{"number":1,"title":"Letters","questions":[{"number":1,"category":"Science","question":"Which planet is known as the Red Planet?","answer":"Mars","points":1,"isPicture":false,"image":null,"info":"Mars has a reddish look because of iron oxide on its surface.","author":"Test","authorImg":null,"qAudio":null,"aAudio":null,"qtype":"letter","qanswer":"M"},{"number":2,"category":"Geography","question":"What is the capital city of Australia?","answer":"Canberra","points":1,"isPicture":false,"image":null,"info":"Many people guess Sydney, but Canberra has been the capital since 1913.","author":"Test","authorImg":null,"qAudio":null,"aAudio":null,"qtype":"letter","qanswer":"C","timer":20},{"number":3,"category":"Science","question":"Which chemical element has the symbol Fe?","answer":"Iron","points":1,"isPicture":false,"image":null,"info":"Fe comes from the Latin word ferrum. QAnswer is blank, so the first letter of Answer is used.","author":"Test","authorImg":null,"qAudio":null,"aAudio":null,"qtype":"letter"},{"number":4,"category":"Music","question":"Which band released the album Abbey Road?","answer":"The Beatles","points":2,"isPicture":false,"image":null,"info":"QAnswer is blank and the answer starts with The, so both T and B are accepted.","author":"Test","authorImg":null,"qAudio":null,"aAudio":null,"qtype":"letter"},{"number":5,"category":"Music","question":"Which musical instrument, played with mallets, has wooden bars and a name that starts with X?","answer":"Xylophone","points":1,"isPicture":false,"image":null,"info":"The X/Y button on the phone covers both X and Y.","author":"Test","authorImg":null,"qAudio":null,"aAudio":null,"qtype":"letter","qanswer":"X"}]},{"number":2,"title":"Numbers","questions":[{"number":1,"category":"Maths","question":"How many sides does a hexagon have?","answer":"6","points":1,"isPicture":false,"image":null,"info":"Hex means six.","author":"Test","autho