{"format":"rumham-quiz","version":3,"title":"Evil Round","created":"2026-10-11","rounds":[{"number":1,"title":"Round 01","questions":[{"number":1,"category":"Geography","question":"Which Wiltshire prehistoric monument, part of a vast Neolithic ceremonial landscape of standing stones, contains the largest stone circle in Europe?","answer":"Avebury","points":1,"isPicture":false,"image":null,"info":"Stonehenge may be the iconic site, but Avebury’s stone circle is over three times the diameter, making it the largest in Europe. Both monuments sit in Wiltshire, and Avebury lies only about 20 miles north of Stonehenge.","author":"Philip","authorImg":null,"qAudio":null,"aAudio":null,"qtype":"letter","qanswer":"a","timer":10,"qpoints":1,"q1st":1,"q2nd":2,"q3rd":3},{"number":2,"category":"Entertainment","question":"Which TV series featured a motorcycle sidecar combo with the registration number N88 TFL?","answer":"Two Fat Ladies","points":1,"isPicture":false,"image":null,"info":"The Two Fat Ladies (Clarissa Dickson Wright & Jennifer Paterson) rode a Triumph Thunderbird with a sidecar.","author":"Russell","authorImg":null,"qAudio":null,"aAudio":null,"qtype":"number","qanswer":"1","timer":20,"qpoints":2,"q1st":2,"q2nd":3,"q3rd":4},{"number":3,"category":"History","question":"In England, what year is known as ‘The Year of Three Kings’?","answer":"1936","points":1,"isPicture":false,"image":null,"info":"George V — died in January 1936, Edward VIII — became king, then abdicated in December 1936, George VI — succeeded his brother immediately after the abdication.","author":"Philip","authorImg":null,"qAudio":null,"aAudio":null,"qtype":"letter","qanswer":"b","timer":30,"qpoints":3,"q1st":3,"q2nd":4,"q3rd":5}]},{"number":2,"title":"Round 02","questions":[{"number":1,"category":"Geography","question":"What mountain range forms the heart of Romania?","answer":"The Carpathian Mountains","points":1,"isPicture":false,"image":null,"info":"The Carpathians span over 1,500 km across Central and Eastern Europe and shelter the largest brown bear population on the continent.","author":"Russell","authorImg":null,"qAudio":null,"aAudio":null,"qtype":"number","qanswer":"2","timer":40,"qpoints":4,"q1st":4,"q2nd":5,"q3rd":6},{"number":2,"category":"Entertainment","question":"Who said of his only heterosexual experience, \"My heart was never in it, but my loins were grateful for the outing and the exercise\"?","answer":"Stephen Fry","points":1,"isPicture":false,"image":null,"info":"Stephen Fry came out publicly as gay in 1994 and has written candidly about his sexuality and bipolar disorder in his autobiography.","author":"Russell","authorImg":null,"qAudio":null,"aAudio":null,"qtype":"letter","qanswer":"c","timer":50,"qpoints":5,"q1st":5,"q2nd":6,"q3rd":7},{"number":3,"category":"History","question":"Which leading figure of the French Revolution was arrested and guillotined in 1794 after the Reign of Terror?","answer":"Maximilien Robespierre","points":1,"isPicture":false,"image":null,"info":"Robespierre was himself arrested and guillotined in 1794 — the Reign of Terror ended almost as abruptly as it began.","author":"Russell","authorImg":null,"qAudio":null,"aAudio":null,"qtype":"number","qanswer":"3","timer":60,"qpoints":6,"q1st":6,"q2nd":7,"q3rd":8}]},{"number":3,"title":"Round 03","questions":[{"number":1,"category":"Geography","question":"Which office complex in Washington DC took its name from a channel leading to the Potomac River?","answer":"The Watergate Complex","points":1,"isPicture":false,"image":null,"info":"The Watergate Complex scandal, which brought down President Nixon in 1974, takes its name from this hotel and office complex.","author":"Russell","authorImg":null,"qAudio":null,"aAudio":null,"qtype":"letter","qanswer":"d","timer":70,"qpoints":7,"q1st":7,"q2nd":8,"q3rd":9},{"number":2,"category":"Entertainment","question":"Which Gary Oldman and Winona Ryder movie used the tagline 'Love never dies'?","answer":"Bram Stoker's Dracula","points":1,"isPicture":false,"image":null,"info":"Francis Ford Coppola's Bram Stoker's Dracula (1992) was praised for its lavish Gothic visuals but polarised critics with its acting.","author":"Russell","authorImg":null,"qAudio":null,"aAudio":null,"qtype":"number","qanswer":"4","timer":80,"qpoints":8,"q1st":8,"q2nd":9,"q3rd":10},{"number":3,"category":"History","question":"Who was known as the Old Pretender?","answer":"James Francis Edward Stuart (also known as James III and VIII to Jacobites)","points":1,"isPicture":false,"image":null,"info":"The term 'Jacobite' derives from 'Jacobus', the Latin form of James, honouring supporters of the exiled Stuart royal line.","author":"Russell","authorImg":null,"qAudio":null,"aAudio":null,"qtype":"letter","qanswer":"e","timer":90,"qpoints":9,"q1st":9,"q2nd":10,"q3rd":11}]},{"number":4,"title":"Round 04","questions":[{"number":1,"category":"Test","question":"Which of these is a fruit?","answer":"Banana","points":1,"isPicture":false,"image":null,"info":"Just to test","author":"Philip","authorImg":null,"qAudio":null,"aAudio":null,"qtype":"multi","qanswer":"Banana","qmulti":["Apple","Banana","Fish","Carrot","Dog","Cat"],"evil":5,"timer":15,"qpoints":4,"q1st":3,"q2nd":2,"q3rd":1},{"number":2,"category":"Test","question":"Which planet is known as the Red Planet?","answer":"Mars","points":1,"isPicture":false,"image":null,"info":"Just to test","author":"Philip","authorImg":null,"qAudio":null,"aAudio":null,"qtype":"multi","qanswer":"Mars","qmulti":["Venus","Mars","Jupiter"],"evil":5,"timer":15,"qpoints":4,"q1st":3,"q2nd":2,"q3rd":1},{"number":3,"category":"Test","question":"In what year were there three kings?","answer":"1936","points":1,"isPicture":false,"image":null,"info":"Just to test","author":"Philip","authorImg":null,"qAudio":null,"aAudio":null,"qtype":"number","qanswer":"1936","reallyevil":10,"timer":15,"qpoints":4,"q1st":3,"q2nd":2,"q3rd":1},{"number":4,"category":"Test","question":"What is the capital of Australia?","answer":"Canberra","points":1,"isPicture":false,"image":null,"info":"Just to test","author":"Philip","authorImg":null,"qAudio":null,"aAudio":null,"qtype":"letter","qanswer":"C","reallyevil":10,"timer":15,"qpoints":4,"q1st":3,"q2nd":2,"q3rd":1}]}],"media":{}}